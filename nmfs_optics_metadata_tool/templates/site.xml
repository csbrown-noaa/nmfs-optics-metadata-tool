<?xml version="1.0" encoding="UTF-8"?>
<gmi:MI_Metadata 
    xmlns:gmi="http://www.isotc211.org/2005/gmi" 
    xmlns:gmd="http://www.isotc211.org/2005/gmd" 
    xmlns:gco="http://www.isotc211.org/2005/gco" 
    xmlns:gml="http://www.opengis.net/gml/3.2"
    xmlns:xlink="http://www.w3.org/1999/xlink">
    
    <!-- Unique Identifier for this specific Site/Transect -->
    <gmd:fileIdentifier>
        <gco:CharacterString>{{ site_uuid }}</gco:CharacterString>
    </gmd:fileIdentifier>
    
    <gmd:language>
        <gmd:LanguageCode codeList="http://www.loc.gov/standards/iso639-2/" codeListValue="eng">eng</gmd:LanguageCode>
    </gmd:language>
    
    <!-- LINK TO PARENT: This ties the Dataset to the Series -->
    <gmd:parentIdentifier>
        <gco:CharacterString>{{ cruise_uuid }}</gco:CharacterString>
    </gmd:parentIdentifier>
    
    <!-- Defines this record as a Child (Dataset) -->
    <gmd:hierarchyLevel>
        <gmd:MD_ScopeCode codeList="http://www.isotc211.org/2005/resources/Codelist/gmxCodelists.xml#MD_ScopeCode" codeListValue="dataset">dataset</gmd:MD_ScopeCode>
    </gmd:hierarchyLevel>
    
    <!-- Standard Info for NOAA/NCEI Compliance -->
    <gmd:metadataStandardName>
        <gco:CharacterString>ISO 19115-2 Geographic Information - Metadata - Part 2: Extensions for Imagery and Gridded Data</gco:CharacterString>
    </gmd:metadataStandardName>
    <gmd:metadataStandardVersion>
        <gco:CharacterString>ISO 19115-2:2009(E)</gco:CharacterString>
    </gmd:metadataStandardVersion>
    
    <gmd:identificationInfo>
        <gmd:MD_DataIdentification>
            <gmd:citation>
                <gmd:CI_Citation>
                    <gmd:title>
                        <gco:CharacterString>{{ site_name }} - {{ type }}</gco:CharacterString>
                    </gmd:title>
                    <gmd:date>
                        <gmd:CI_Date>
                            <gmd:date><gco:Date>{{ today_date }}</gco:Date></gmd:date>
                            <gmd:dateType>
                                <gmd:CI_DateTypeCode codeList="http://www.isotc211.org/2005/resources/Codelist/gmxCodelists.xml#CI_DateTypeCode" codeListValue="creation">creation</gmd:CI_DateTypeCode>
                            </gmd:dateType>
                        </gmd:CI_Date>
                    </gmd:date>
                </gmd:CI_Citation>
            </gmd:citation>
            <gmd:abstract>
                <gco:CharacterString>Data collected at {{ site_name }} during cruise {{ cruise_name }}.</gco:CharacterString>
            </gmd:abstract>
            
            <!-- Specific Spatial and Temporal Extent of this Event -->
            <gmd:extent>
                <gmd:EX_Extent>
                    <gmd:geographicElement>
                        <gmd:EX_BoundingPolygon>
                            <gmd:polygon>
                                {% if type == 'Drop Site' %}
                                <gml:Point gml:id="geom_{{ site_uuid }}">
                                    <gml:pos>{{ lat }} {{ lon }}</gml:pos>
                                </gml:Point>
                                {% elif type == 'Transect' %}
                                <gml:LineString gml:id="geom_{{ site_uuid }}">
                                    <!-- A line string expects multiple lat/lon pairs separated by spaces. Example data format handled in python. -->
                                    <gml:posList>{{ geometry }}</gml:posList>
                                </gml:LineString>
                                {% endif %}
                            </gmd:polygon>
                        </gmd:EX_BoundingPolygon>
                    </gmd:geographicElement>
                    
                    <gmd:temporalElement>
                        <gmd:EX_TemporalExtent>
                            <gmd:extent>
                                <gml:TimePeriod gml:id="time_{{ site_uuid }}">
                                    <gml:beginPosition>{{ start_time }}</gml:beginPosition>
                                    <gml:endPosition>{{ end_time }}</gml:endPosition>
                                </gml:TimePeriod>
                            </gmd:extent>
                        </gmd:EX_TemporalExtent>
                    </gmd:temporalElement>
                </gmd:EX_Extent>
            </gmd:extent>
        </gmd:MD_DataIdentification>
    </gmd:identificationInfo>
    
    <!-- Ship, Operation, and Sensor details -->
    <gmi:acquisitionInformation>
        <gmi:MI_AcquisitionInformation>
            <!-- Operation = The specific Cast/Transect Event -->
            <gmi:operation>
                <gmi:MI_Operation>
                    <gmi:description><gco:CharacterString>{{ site_name }}</gco:CharacterString></gmi:description>
                    <gmi:identifier>
                        <gmd:MD_Identifier>
                            <gmd:code><gco:CharacterString>{{ site_name }}</gco:CharacterString></gmd:code>
                        </gmd:MD_Identifier>
                    </gmi:identifier>
                    <gmi:status>
                        <gmd:MD_ProgressCode codeList="http://www.isotc211.org/2005/resources/Codelist/gmxCodelists.xml#MD_ProgressCode" codeListValue="completed">completed</gmd:MD_ProgressCode>
                    </gmi:status>
                </gmi:MI_Operation>
            </gmi:operation>
            <gmi:platform>
                <gmi:MI_Platform>
                    <gmi:citation>
                        <gmd:CI_Citation>
                            <gmd:title><gco:CharacterString>{{ ship_name }}</gco:CharacterString></gmd:title>
                        </gmd:CI_Citation>
                    </gmi:citation>
                    <gmi:identifier>
                        <gmd:MD_Identifier>
                            <gmd:code><gco:CharacterString>{{ ship_name }}</gco:CharacterString></gmd:code>
                        </gmd:MD_Identifier>
                    </gmi:identifier>
                    <gmi:description><gco:CharacterString>Research Vessel</gco:CharacterString></gmi:description>
                    
                    <!-- CTD or other Instrument attached to the Platform -->
                    {% if instrument_name %}
                    <gmi:instrument>
                        <gmi:MI_Instrument>
                            <gmi:citation>
                                <gmd:CI_Citation>
                                    <gmd:title><gco:CharacterString>{{ instrument_name }}</gco:CharacterString></gmd:title>
                                </gmd:CI_Citation>
                            </gmi:citation>
                            <gmi:type>
                                <gco:CharacterString>{{ instrument_type }}</gco:CharacterString>
                            </gmi:type>
                        </gmi:MI_Instrument>
                    </gmi:instrument>
                    {% endif %}
                    
                </gmi:MI_Platform>
            </gmi:platform>
        </gmi:MI_AcquisitionInformation>
    </gmi:acquisitionInformation>
</gmi:MI_Metadata>

