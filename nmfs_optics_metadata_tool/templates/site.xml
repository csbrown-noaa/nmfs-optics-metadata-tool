<?xml version="1.0" encoding="UTF-8"?>
<gmi:MI_Metadata xmlns:gmi="http://www.isotc211.org/2005/gmi"
                 xmlns:gmd="http://www.isotc211.org/2005/gmd"
                 xmlns:gco="http://www.isotc211.org/2005/gco"
                 xmlns:gml="http://www.opengis.net/gml/3.2"
                 xmlns:xlink="http://www.w3.org/1999/xlink"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="http://www.isotc211.org/2005/gmi https://data.noaa.gov/resources/iso19139/schema.xsd">

  <!-- ========================================== -->
  <!-- METADATA RECORD IDENTIFICATION             -->
  <!-- ========================================== -->
  <gmd:fileIdentifier>
    <gco:CharacterString>{{ METADATA_RECORD_UUID }}</gco:CharacterString>
  </gmd:fileIdentifier>
  <gmd:language>
    <gco:CharacterString>eng; US</gco:CharacterString>
  </gmd:language>
  <gmd:characterSet>
    <gmd:MD_CharacterSetCode codeList="http://standards.iso.org/ittf/PubliclyAvailableStandards/ISO_19139_Schemas/resources/codelist/gmxCodelists.xml#MD_CharacterSetCode" codeListValue="utf8">utf8</gmd:MD_CharacterSetCode>
  </gmd:characterSet>

  <!-- Survey POC / Metadata Contact -->
  <gmd:contact>
    <gmd:CI_ResponsibleParty>
      <gmd:individualName>
        <gco:CharacterString>{{ SURVEY_POC_NAME }}</gco:CharacterString>
      </gmd:individualName>
      <gmd:organisationName>
        <gco:CharacterString>{{ SURVEY_POC_ORGANIZATION }}</gco:CharacterString>
      </gmd:organisationName>
      <gmd:contactInfo>
        <gmd:CI_Contact>
          <gmd:address>
            <gmd:CI_Address>
              <gmd:electronicMailAddress>
                <gco:CharacterString>{{ SURVEY_POC_EMAIL }}</gco:CharacterString>
              </gmd:electronicMailAddress>
            </gmd:CI_Address>
          </gmd:address>
        </gmd:CI_Contact>
      </gmd:contactInfo>
      <gmd:role>
        <gmd:CI_RoleCode codeList="http://standards.iso.org/ittf/PubliclyAvailableStandards/ISO_19139_Schemas/resources/codelist/gmxCodelists.xml#CI_RoleCode" codeListValue="pointOfContact">pointOfContact</gmd:CI_RoleCode>
      </gmd:role>
    </gmd:CI_ResponsibleParty>
  </gmd:contact>

  <gmd:dateStamp>
    <gco:Date>{{ METADATA_CREATION_DATE }}</gco:Date>
  </gmd:dateStamp>

  <!-- ========================================== -->
  <!-- DATA IDENTIFICATION                        -->
  <!-- ========================================== -->
  <gmd:identificationInfo>
    <gmd:MD_DataIdentification>
      <gmd:citation>
        <gmd:CI_Citation>
          <!-- Survey Name -->
          <gmd:title>
            <gco:CharacterString>{{ SURVEY_NAME }}</gco:CharacterString>
          </gmd:title>
          <gmd:date>
            <gmd:CI_Date>
              <gmd:date>
                <gco:Date>{{ SURVEY_CREATION_DATE }}</gco:Date>
              </gmd:date>
              <gmd:dateType>
                <gmd:CI_DateTypeCode codeList="http://standards.iso.org/ittf/PubliclyAvailableStandards/ISO_19139_Schemas/resources/codelist/gmxCodelists.xml#CI_DateTypeCode" codeListValue="creation">creation</gmd:CI_DateTypeCode>
              </gmd:dateType>
            </gmd:CI_Date>
          </gmd:date>

          <!-- Data Owner -->
          <gmd:citedResponsibleParty>
            <gmd:CI_ResponsibleParty>
              <gmd:organisationName>
                <gco:CharacterString>{{ DATA_OWNER_ORGANIZATION }}</gco:CharacterString>
              </gmd:organisationName>
              <gmd:contactInfo>
                <gmd:CI_Contact>
                  <gmd:address>
                    <gmd:CI_Address>
                      <gmd:electronicMailAddress>
                        <gco:CharacterString>{{ DATA_OWNER_EMAIL }}</gco:CharacterString>
                      </gmd:electronicMailAddress>
                    </gmd:CI_Address>
                  </gmd:address>
                </gmd:CI_Contact>
              </gmd:contactInfo>
              <gmd:role>
                <gmd:CI_RoleCode codeList="http://standards.iso.org/ittf/PubliclyAvailableStandards/ISO_19139_Schemas/resources/codelist/gmxCodelists.xml#CI_RoleCode" codeListValue="owner">owner</gmd:CI_RoleCode>
              </gmd:role>
            </gmd:CI_ResponsibleParty>
          </gmd:citedResponsibleParty>
        </gmd:CI_Citation>
      </gmd:citation>

      <gmd:abstract>
        <gco:CharacterString>{{ SURVEY_ABSTRACT }}</gco:CharacterString>
      </gmd:abstract>

      <!-- Survey POC (Identification level) -->
      <gmd:pointOfContact>
        <gmd:CI_ResponsibleParty>
          <gmd:individualName>
            <gco:CharacterString>{{ SURVEY_POC_NAME }}</gco:CharacterString>
          </gmd:individualName>
          <gmd:organisationName>
            <gco:CharacterString>{{ SURVEY_POC_ORGANIZATION }}</gco:CharacterString>
          </gmd:organisationName>
          <gmd:contactInfo>
            <gmd:CI_Contact>
              <gmd:address>
                <gmd:CI_Address>
                  <gmd:electronicMailAddress>
                    <gco:CharacterString>{{ SURVEY_POC_EMAIL }}</gco:CharacterString>
                  </gmd:electronicMailAddress>
                </gmd:CI_Address>
              </gmd:address>
            </gmd:CI_Contact>
          </gmd:contactInfo>
          <gmd:role>
            <gmd:CI_RoleCode codeList="http://standards.iso.org/ittf/PubliclyAvailableStandards/ISO_19139_Schemas/resources/codelist/gmxCodelists.xml#CI_RoleCode" codeListValue="pointOfContact">pointOfContact</gmd:CI_RoleCode>
          </gmd:role>
        </gmd:CI_ResponsibleParty>
      </gmd:pointOfContact>

      <gmd:topicCategory>
        <gmd:MD_TopicCategoryCode>oceans</gmd:MD_TopicCategoryCode>
      </gmd:topicCategory>

      <!-- ========================================== -->
      <!-- EXTENTS (Spatial, Temporal, Vertical)      -->
      <!-- ========================================== -->
      <gmd:extent>
        <gmd:EX_Extent>
          <!-- Geographic Bounding Box -->
          <gmd:geographicElement>
            <gmd:EX_GeographicBoundingBox>
              <gmd:westBoundLongitude>
                <gco:Decimal>{{ WEST_BOUND_LONGITUDE }}</gco:Decimal>
              </gmd:westBoundLongitude>
              <gmd:eastBoundLongitude>
                <gco:Decimal>{{ EAST_BOUND_LONGITUDE }}</gco:Decimal>
              </gmd:eastBoundLongitude>
              <gmd:southBoundLatitude>
                <gco:Decimal>{{ SOUTH_BOUND_LATITUDE }}</gco:Decimal>
              </gmd:southBoundLatitude>
              <gmd:northBoundLatitude>
                <gco:Decimal>{{ NORTH_BOUND_LATITUDE }}</gco:Decimal>
              </gmd:northBoundLatitude>
            </gmd:EX_GeographicBoundingBox>
          </gmd:geographicElement>

          <!-- Collection Date (Temporal Extent) -->
          <gmd:temporalElement>
            <gmd:EX_TemporalExtent>
              <gmd:extent>
                <gml:TimePeriod gml:id="collectionPeriod">
                  <gml:beginPosition>{{ COLLECTION_START_TIME }}</gml:beginPosition>
                  <gml:endPosition>{{ COLLECTION_END_TIME }}</gml:endPosition>
                </gml:TimePeriod>
              </gmd:extent>
            </gmd:EX_TemporalExtent>
          </gmd:temporalElement>

          <!-- Depth / Altitude (Vertical Extent - Optional) -->
          <gmd:verticalElement>
            <gmd:EX_VerticalExtent>
              <gmd:minimumValue>
                <gco:Real>{{ MIN_DEPTH_OR_ALTITUDE }}</gco:Real>
              </gmd:minimumValue>
              <gmd:maximumValue>
                <gco:Real>{{ MAX_DEPTH_OR_ALTITUDE }}</gco:Real>
              </gmd:maximumValue>
              <gmd:verticalCRS gco:nilReason="unknown"/>
            </gmd:EX_VerticalExtent>
          </gmd:verticalElement>
        </gmd:EX_Extent>
      </gmd:extent>

    </gmd:MD_DataIdentification>
  </gmd:identificationInfo>

  <!-- ========================================== -->
  <!-- DISTRIBUTION / GCS PATH                    -->
  <!-- ========================================== -->
  <gmd:distributionInfo>
    <gmd:MD_Distribution>
      <gmd:transferOptions>
        <gmd:MD_DigitalTransferOptions>
          <gmd:onLine>
            <gmd:CI_OnlineResource>
              <!-- GCS Path -->
              <gmd:linkage>
                <gmd:URL>{{ GCS_BUCKET_URI }}</gmd:URL>
              </gmd:linkage>
              <gmd:protocol>
                <gco:CharacterString>cloud:GCS</gco:CharacterString>
              </gmd:protocol>
              <gmd:name>
                <gco:CharacterString>{{ ASSET_OR_FOLDER_NAME }}</gco:CharacterString>
              </gmd:name>
              <gmd:function>
                <gmd:CI_OnLineFunctionCode codeList="http://standards.iso.org/ittf/PubliclyAvailableStandards/ISO_19139_Schemas/resources/codelist/gmxCodelists.xml#CI_OnLineFunctionCode" codeListValue="download">download</gmd:CI_OnLineFunctionCode>
              </gmd:function>
            </gmd:CI_OnlineResource>
          </gmd:onLine>
        </gmd:MD_DigitalTransferOptions>
      </gmd:transferOptions>
    </gmd:MD_Distribution>
  </gmd:distributionInfo>

  <!-- ============================================================== -->
  <!-- ACQUISITION INFORMATION (Site/Dive ID, Temp, Salinity)          -->
  <!-- ============================================================== -->
  <gmi:acquisitionInformation>
    <gmi:MI_AcquisitionInformation>
      <gmi:operation>
        <gmi:MI_Operation>
          <!-- Site / Dive ID -->
          <gmi:identifier>
            <gmd:MD_Identifier>
              <gmd:code>
                <gco:CharacterString>{{ SITE_OR_DIVE_ID }}</gco:CharacterString>
              </gmd:code>
            </gmd:MD_Identifier>
          </gmi:identifier>
          <gmi:status>
            <gmd:MD_ProgressCode codeList="http://standards.iso.org/ittf/PubliclyAvailableStandards/ISO_19139_Schemas/resources/codelist/gmxCodelists.xml#MD_ProgressCode" codeListValue="completed">completed</gmd:MD_ProgressCode>
          </gmi:status>

          <!-- Significant Event for In-Situ Environmental Parameters -->
          <gmi:significantEvent>
            <gmi:MI_Event>
              <gmi:identifier>
                <gmd:MD_Identifier>
                  <gmd:code>
                    <gco:CharacterString>{{ SITE_OR_DIVE_ID }}_observation_conditions</gco:CharacterString>
                  </gmd:code>
                </gmd:MD_Identifier>
              </gmi:identifier>
              <gmi:trigger>
                <gmi:MI_TriggerCode codeList="http://standards.iso.org/ittf/PubliclyAvailableStandards/ISO_19139_Schemas/resources/codelist/gmxCodelists.xml#MI_TriggerCode" codeListValue="manual">manual</gmi:MI_TriggerCode>
              </gmi:trigger>
              <gmi:context>
                <gmi:MI_ContextCode codeList="http://standards.iso.org/ittf/PubliclyAvailableStandards/ISO_19139_Schemas/resources/codelist/gmxCodelists.xml#MI_ContextCode" codeListValue="acquisition">acquisition</gmi:MI_ContextCode>
              </gmi:context>
              <gmi:sequence>
                <gmi:MI_SequenceCode codeList="http://standards.iso.org/ittf/PubliclyAvailableStandards/ISO_19139_Schemas/resources/codelist/gmxCodelists.xml#MI_SequenceCode" codeListValue="instantaneous">instantaneous</gmi:MI_SequenceCode>
              </gmi:sequence>
              <gmi:time>
                <gco:DateTime>{{ COLLECTION_START_TIME }}</gco:DateTime>
              </gmi:time>

              <!-- Temperature & Salinity (Environmental Conditions - Optional) -->
              <gmi:environmentalConditions>
                <gco:CharacterString>Water Temperature: {{ TEMPERATURE_VALUE }} {{ TEMPERATURE_UNITS }}; Salinity: {{ SALINITY_VALUE }} {{ SALINITY_UNITS }}</gco:CharacterString>
              </gmi:environmentalConditions>
            </gmi:MI_Event>
          </gmi:significantEvent>

        </gmi:MI_Operation>
      </gmi:operation>
    </gmi:MI_AcquisitionInformation>
  </gmi:acquisitionInformation>

</gmi:MI_Metadata>
